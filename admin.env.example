# Copy to ~/.tenuo/admin.env (gitignored on your machine; never in this repo).
#
# Create an **admin-scoped** API key in Tenuo Cloud (NOT included in Quick Connect):
#   cloud.tenuo.ai → Settings → API Keys → Create key (Admin scope)
#
# Or use the separate admin key your Tenuo contact sent at tenant onboarding.
#
# Used ONLY by `tenuo_admin.py setup` (register holder agent, create trigger).
# Do NOT put this in .state/cloud.env — `tenuo-claude` refuses to run if an
# admin key is reachable from the runtime environment.

export TENUO_ADMIN_KEY="tc_..."
