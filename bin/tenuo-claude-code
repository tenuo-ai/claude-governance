#!/usr/bin/env bash
# Stable launcher for hooks, MCP proxy, and the tenuo-claude-code CLI.
#
# Resolves Python from TENUO_PYTHON, the project .venv, uv, or python3 on PATH.
# Reference from .mcp.json and Claude hooks when using the git-clone workflow.
#
# Enterprise: set TENUO_ROOT to the governed project directory and optionally
# TENUO_PYTHON to a fleet-managed interpreter.
set -euo pipefail

if [[ -n "${TENUO_ROOT:-}" ]]; then
  ROOT="$TENUO_ROOT"
else
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi
cd "$ROOT"

run_python() {
  local py="$1"
  shift
  if python3 -c "import tenuo_claude_code" 2>/dev/null; then
    exec "$py" -m tenuo_claude_code.cli "$@"
  fi
  if [[ -f "$ROOT/tenuo_claude.py" ]]; then
    exec "$py" "$ROOT/tenuo_claude.py" "$@"
  fi
  exec "$py" -m tenuo_claude_code.cli "$@"
}

if [[ -n "${TENUO_PYTHON:-}" ]]; then
  run_python "$TENUO_PYTHON" "$@"
fi
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  run_python "$ROOT/.venv/bin/python" "$@"
fi
if command -v uv >/dev/null 2>&1; then
  exec uv run tenuo-claude-code "$@"
fi
run_python python3 "$@"
