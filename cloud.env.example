# Copy to .state/cloud.env (gitignored) and fill in from your Tenuo Cloud dashboard.
# When present, `tenuo-claude up` connects the authorizer to Cloud for
# heartbeat, SRL (revocation) sync, and signed-receipt streaming.
#
# RUNTIME plane only: this file must hold the Quick Connect / authorizer runtime
# key, never the tenant-admin key (tenuo-claude refuses to run if one is reachable).
# The admin key lives in ~/.tenuo/admin.env and is used only by `tenuo-admin`.
#
# This service account needs RBAC permissions for agent claim, trigger fire,
# receipt streaming, and SRL sync (included on the Quick Connect authorizer role).

# base URL (no /v1)
export TENUO_CONTROL_PLANE_URL="https://api.tenuo.ai"
# runtime / authorizer API key (from Quick Connect)
export TENUO_API_KEY="tc__..."
export TENUO_AUTHORIZER_NAME="claude-code-demo"

# Optional: public key (hex) your tenant signs SRLs with. Auto-discovered from
# the signed SRL when omitted; pin it to skip that lookup:
#   curl -s "$TENUO_CONTROL_PLANE_URL/v1/revocations/srl/signed" \
#     -H "Authorization: Bearer $TENUO_API_KEY" | jq -r .payload.Issuer | base64 -d | xxd -p -c32
# export TENUO_TENANT_ROOT="<64-char hex>"
