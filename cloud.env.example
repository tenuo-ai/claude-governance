# Copy to .state/cloud.env (gitignored) and fill in from Tenuo Cloud Quick Connect.
# When present, `tenuo-claude up` connects the authorizer to Cloud for
# heartbeat, SRL (revocation) sync, and signed-receipt streaming.
#
# RUNTIME plane only: this file must hold the Quick Connect / authorizer runtime
# key, never the tenant-admin key (tenuo-claude refuses to run if one is reachable).
# The admin key lives in ~/.tenuo/admin.env and is used only by `tenuo-admin`.
#
# ── Get credentials: Quick Connect (dashboard) ─────────────────────────────
#
# Quick Connect gives one connect token (`tenuo_ct_…`) that bundles URL + bearer
# key. Set TENUO_CONNECT_TOKEN below — no need to also set TENUO_API_KEY unless
# you use the Manual tab and paste the parts separately.
#
# 1. Sign in at https://cloud.tenuo.ai
# 2. Open **Agents** → click **Quick Connect**
# 3. Connection type: **Authorizer Only** — not Agent + Authorizer. The demo
#    uses a sidecar authorizer (Quick Connect creds) and a separate holder agent
#    (registered by tenuo-admin, PoP key in .state/holder_key.b64).
# 4. Copy the connect token (`tenuo_ct_…`) — shown once; treat like a password
#
# Option A (preferred): paste the whole token here:
# export TENUO_CONNECT_TOKEN="tenuo_ct_..."
# export TENUO_AUTHORIZER_NAME="claude-code-demo"
#
# Option B: in Quick Connect choose deployment **Manual**, copy the extracted
# values into the vars below (do not include /v1 in the URL):
#
# export TENUO_CONTROL_PLANE_URL="https://api.tenuo.ai"
# export TENUO_API_KEY="tc_..."
# export TENUO_AUTHORIZER_NAME="claude-code-demo"
#
# Do NOT paste `ak_…` key IDs from the API Keys table — those are identifiers,
# not bearer secrets. Quick Connect gives the actual `tc_…` runtime key.
#
# This service account needs RBAC for agent claim, trigger fire, receipt
# streaming, and SRL sync (included on the Quick Connect authorizer role).

export TENUO_CONNECT_TOKEN="tenuo_ct_..."
export TENUO_AUTHORIZER_NAME="claude-code-demo"

# Optional: public key (hex) your tenant signs SRLs with. Auto-discovered from
# the signed SRL when omitted; pin it to skip that lookup:
#   curl -s "$TENUO_CONTROL_PLANE_URL/v1/revocations/srl/signed" \
#     -H "Authorization: Bearer $TENUO_API_KEY" | jq -r .payload.Issuer | base64 -d | xxd -p -c32
# export TENUO_TENANT_ROOT="<64-char hex>"
