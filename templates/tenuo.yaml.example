# Copy to tenuo.yaml in your project directory, or run `tenuo-claude bootstrap` in an empty folder.

name: your-project

sandbox: ./workspace

# Session warrant lifetime in seconds. Optional; defaults to 3600 (1h). `up`
# re-mints before expiry. Enterprise deployments pin this centrally via Claude
# Code managed settings / MDM; local dev can set it here. Positive integer.
# ttl_seconds: 3600

mode: enforce

enforce:
  Read: "subpath:{sandbox}"
  Bash: "shlex:ls,pwd,echo,date"

default: deny
