# Optional Cloud overlay — merge into tenuo.yaml (or paste under `name:`).
#
# 1. Copy cloud.env.example -> .state/cloud.env and fill in your keys.
# 2. Add the block below to tenuo.yaml (keep `enforce.WebFetch.approval` if you
#    want the human-approval gate).
# 3. Run:  python3 tenuo_admin.py setup && python3 tenuo_claude.py up
#
# The admin key lives in ~/.tenuo/admin.env (never in this repo).

cloud:
  url: https://api.tenuo.ai
  # Display name of an existing Cloud identity binding (KMS key + notification
  # routing). `tenuo-admin setup` resolves this and wires the approval policy.
  approver_identity: "Your Approver Display Name"
